---
import { Font } from 'astro:assets';
import site from '../data/site.json';
import ViewToggle from '../components/ViewToggle.astro';
import Contact from '../components/Contact.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.headline } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.role}`;
---

<!doctype html>
<html lang="es" data-view="general">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-sans" preload={[{ weight: 400 }, { weight: 600 }]} />
    <Font cssVariable="--font-display" preload={[{ weight: 900 }]} />
    <Font cssVariable="--font-mono" />
    <title>{pageTitle}</title>
    <script is:inline>
      try {
        const v = localStorage.getItem('view');
        if (v === 'tecnica' || v === 'general') document.documentElement.dataset.view = v;
      } catch {}
    </script>
  </head>
  <body>
    <header class="topbar">
      <div class="wrap topbar-inner">
        <a href="/" class="brand">{site.name}</a>
        <nav class="nav" aria-label="Principal">
          <a href="/#proyectos">Proyectos</a>
          <a href="/#actividad">Actividad</a>
          <a href="/#contacto">Contacto</a>
        </nav>
        <ViewToggle />
      </div>
    </header>
    <main>
      <slot />
    </main>
    <Contact />
    <div id="tip" class="tip" role="tooltip" hidden></div>
    <script>
      import '../scripts/tooltip';
    </script>
  </body>
</html>
