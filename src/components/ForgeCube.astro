---
// Cubo de alambre con una masa de lava adentro. Se dibuja con WebGL (Three.js) cuando el
// navegador tiene WebGL 2; si no (escritorios remotos, equipos sin aceleración gráfica),
// con un respaldo en Canvas 2D que se ve y se mueve igual. Three.js solo se descarga en
// el primer caso. Se rota arrastrando; al pasar el cursor se inclina hacia él.
---

<div class="forge" data-forge aria-hidden="true"></div>

<script>
  import { createCanvasRenderer } from '../lib/forge/canvas2d';
  import type { ForgeRenderer } from '../lib/forge/types';

  const REST_X = -0.42;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const clamp = (v: number, min: number, max: number) => Math.min(max, Math.max(min, v));
  const TURN = Math.PI * 2;
  // La inclinación de reposo más cercana (mismo ángulo + vueltas completas): tras girar en
  // vertical, el cubo vuelve a su postura sin desenrollar las vueltas que dio.
  const restNear = (x: number) => REST_X + Math.round((x - REST_X) / TURN) * TURN;

  // Solo WebGL con aceleración de hardware. Sin GPU el navegador lo simula por software y cada
  // cuadro bloquea la página; en ese caso el respaldo 2D es mucho más liviano.
  function hasWebGL2() {
    try {
      const gl = document.createElement('canvas').getContext('webgl2', { failIfMajorPerformanceCaveat: true });
      if (!gl) return false;
      const info = gl.getExtension('WEBGL_debug_renderer_info');
      const name = info ? String(gl.getParameter(info.UNMASKED_RENDERER_WEBGL)) : '';
      gl.getExtension('WEBGL_lose_context')?.loseContext();
      return !/swiftshader|llvmpipe|softpipe|basic render|software/i.test(name);
    } catch {
      return false;
    }
  }

  // El cubo es decoración: arranca cuando la página ya cargó y el navegador está libre, para no
  // competir con el texto principal.
  const whenIdle = (fn: () => void) => {
    const run = () => ('requestIdleCallback' in window ? requestIdleCallback(fn, { timeout: 1500 }) : setTimeout(fn, 200));
    if (document.readyState === 'complete') run();
    else window.addEventListener('load', run, { once: true });
  };

  async function createRenderer(host: HTMLElement): Promise<ForgeRenderer> {
    if (hasWebGL2()) {
      try {
        const { createWebGLRenderer } = await import('../lib/forge/webgl');
        return createWebGLRenderer(host);
      } catch {
        host.replaceChildren(); // quita un canvas a medio crear antes del respaldo
      }
    }
    return createCanvasRenderer(host);
  }

  whenIdle(() => document.querySelectorAll<HTMLElement>('[data-forge]').forEach(async (host) => {
    const view = await createRenderer(host);
    host.dataset.renderer = view.kind;

    const resize = () => view.resize(host.clientWidth);
    new ResizeObserver(resize).observe(host);
    resize();

    // Interacción: giro solo, inclinación hacia el cursor y arrastre con impulso.
    const zone = host.closest<HTMLElement>('[data-cube-zone]') ?? host;
    let rx = REST_X, ry = 0.6, tx = REST_X, ty = 0.6, spin = 0, spinX = 0;
    let mode: 'auto' | 'hover' | 'drag' = 'auto';
    let hoverBase = 0;
    let hoverBaseX = REST_X;
    let last = { x: 0, y: 0 };

    zone.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse' || mode === 'drag') return;
      mode = 'hover';
      hoverBase = ty;
      hoverBaseX = restNear(tx);
    });
    zone.addEventListener('pointerleave', () => {
      if (mode === 'hover') mode = 'auto';
    });
    zone.addEventListener('pointermove', (e) => {
      if (mode !== 'hover') return;
      const r = zone.getBoundingClientRect();
      const nx = ((e.clientX - r.left) / r.width - 0.5) * 2;
      const ny = ((e.clientY - r.top) / r.height - 0.5) * 2;
      ty = hoverBase + nx * 1.1;
      tx = hoverBaseX + ny * 0.7;
    });
    host.addEventListener('pointerdown', (e) => {
      mode = 'drag';
      spin = 0;
      spinX = 0;
      last = { x: e.clientX, y: e.clientY };
      host.setPointerCapture(e.pointerId);
      host.classList.add('dragging');
    });
    host.addEventListener('pointermove', (e) => {
      if (mode !== 'drag') return;
      const dx = e.clientX - last.x;
      const dy = e.clientY - last.y;
      last = { x: e.clientX, y: e.clientY };
      ty += dx * 0.01;
      tx += dy * 0.01; // sin tope: también da vueltas completas en vertical
      spin = clamp(dx * 0.01, -0.3, 0.3);
      spinX = clamp(dy * 0.01, -0.3, 0.3);
    });
    const release = (e: PointerEvent) => {
      if (mode !== 'drag') return;
      host.classList.remove('dragging');
      const r = zone.getBoundingClientRect();
      const inside = e.pointerType === 'mouse' && e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
      mode = inside ? 'hover' : 'auto';
      hoverBase = ty;
      hoverBaseX = restNear(tx);
    };
    host.addEventListener('pointerup', release);
    host.addEventListener('pointercancel', release);

    let time = 0;
    let lastTime = performance.now();
    let visible = true;
    let frame = 0;
    const tick = () => {
      const now = performance.now();
      const dt = Math.min((now - lastTime) / 1000, 0.05);
      lastTime = now;
      if (!reduceMotion.matches) time += dt;
      if (mode === 'auto') {
        ty += spin;
        spin *= 0.95;
        if (Math.abs(spin) < 0.002 && !reduceMotion.matches) ty += dt * 0.25;
        tx += spinX;
        spinX *= 0.95;
        if (Math.abs(spinX) < 0.002) tx += (restNear(tx) - tx) * 0.02;
      }
      const ease = mode === 'drag' ? 0.35 : 0.08;
      rx += (tx - rx) * ease;
      ry += (ty - ry) * ease;
      view.render(rx, ry, time);
      frame = visible ? requestAnimationFrame(tick) : 0;
    };

    // Fuera de pantalla no se dibuja: no gasta batería.
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible && !frame) {
        lastTime = performance.now();
        frame = requestAnimationFrame(tick);
      }
    }).observe(host);
  }));
</script>

<style>
  .forge {
    position: relative;
    width: min(100%, 520px);
    aspect-ratio: 1;
    cursor: grab;
    touch-action: none;
    user-select: none;
  }
  .forge.dragging {
    cursor: grabbing;
  }
  .forge :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    animation: forge-in 0.6s ease-out;
  }
  @keyframes forge-in {
    from { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .forge :global(canvas) { animation: none; }
  }
</style>
