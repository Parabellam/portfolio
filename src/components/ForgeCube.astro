---
// Un cubo de alambre con aristas brillantes y, dentro, una masa de lava que se deforma
// sin parar. Dibujado con Canvas 2D (no WebGL) para que funcione en cualquier navegador,
// incluidos escritorios remotos y equipos sin aceleración gráfica.
// Se rota arrastrando; al pasar el cursor se inclina hacia él.
---

<div class="forge" data-forge aria-hidden="true">
  <canvas></canvas>
</div>

<script>
  const REST_X = -0.42;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const clamp = (v: number, min: number, max: number) => Math.min(max, Math.max(min, v));

  // Vértices y aristas de un cubo de lado 2.
  const V: [number, number, number][] = [];
  for (const x of [-1, 1]) for (const y of [-1, 1]) for (const z of [-1, 1]) V.push([x, y, z]);
  const EDGES: [number, number][] = [];
  for (let a = 0; a < 8; a++) {
    for (let b = a + 1; b < 8; b++) {
      const diff = V[a].reduce((n, c, i) => n + (c !== V[b][i] ? 1 : 0), 0);
      if (diff === 1) EDGES.push([a, b]);
    }
  }

  document.querySelectorAll<HTMLElement>('[data-forge]').forEach((host) => {
    const canvas = host.querySelector('canvas')!;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let size = 0;
    let dpr = 1;
    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      size = host.clientWidth;
      canvas.width = Math.round(size * dpr);
      canvas.height = Math.round(size * dpr);
    };
    new ResizeObserver(resize).observe(host);
    resize();

    // Rotación, perspectiva y proyección a pantalla.
    const project = (p: [number, number, number], rx: number, ry: number, rz: number) => {
      let [x, y, z] = p;
      let t = x * Math.cos(ry) + z * Math.sin(ry);
      z = -x * Math.sin(ry) + z * Math.cos(ry);
      x = t;
      t = y * Math.cos(rx) - z * Math.sin(rx);
      z = y * Math.sin(rx) + z * Math.cos(rx);
      y = t;
      t = x * Math.cos(rz) - y * Math.sin(rz);
      y = x * Math.sin(rz) + y * Math.cos(rz);
      x = t;
      const f = 4.2;
      const s = f / (f - z); // z > 0 = más cerca
      const k = size * 0.25;
      return { x: size / 2 + x * s * k, y: size / 2 + y * s * k, z };
    };

    // Contorno de la masa: radio que ondula con varias frecuencias (lóbulos grandes y lisos).
    const blobPath = (t: number, spin: number) => {
      const R = size * 0.2;
      const n = 120;
      ctx.beginPath();
      for (let i = 0; i <= n; i++) {
        const a = (i / n) * Math.PI * 2;
        const q = a + spin;
        const r =
          R *
          (1 +
            0.13 * Math.sin(3 * q + t * 0.9) +
            0.09 * Math.sin(2 * q - t * 0.7 + 1.3) +
            0.05 * Math.sin(5 * q + t * 1.3 + 0.4) +
            0.03 * Math.sin(7 * q - t * 1.7));
        const x = size / 2 + Math.cos(a) * r;
        const y = size / 2 + Math.sin(a) * r;
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.closePath();
    };

    const drawEdge = (a: { x: number; y: number }, b: { x: number; y: number }) => {
      ctx.globalCompositeOperation = 'lighter';
      ctx.strokeStyle = 'rgba(255, 106, 30, 0.16)';
      ctx.lineWidth = 7;
      ctx.beginPath();
      ctx.moveTo(a.x, a.y);
      ctx.lineTo(b.x, b.y);
      ctx.stroke();
      ctx.globalCompositeOperation = 'source-over';
      ctx.shadowColor = 'rgba(255, 110, 30, 0.95)';
      ctx.shadowBlur = 10;
      ctx.strokeStyle = '#ffc995';
      ctx.lineWidth = 1.4;
      ctx.beginPath();
      ctx.moveTo(a.x, a.y);
      ctx.lineTo(b.x, b.y);
      ctx.stroke();
      ctx.shadowBlur = 0;
    };

    const drawCorner = (p: { x: number; y: number; z: number }) => {
      const r = 9 * (1 + p.z * 0.15);
      const g = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, r);
      g.addColorStop(0, 'rgba(255, 244, 220, 1)');
      g.addColorStop(0.3, 'rgba(255, 170, 90, 0.8)');
      g.addColorStop(1, 'rgba(255, 90, 31, 0)');
      ctx.globalCompositeOperation = 'lighter';
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.arc(p.x, p.y, r, 0, Math.PI * 2);
      ctx.fill();
      ctx.globalCompositeOperation = 'source-over';
    };

    const drawBlob = (t: number, ry: number) => {
      const c = size / 2;
      const R = size * 0.2;
      // Brillo exterior.
      ctx.save();
      ctx.shadowColor = 'rgba(255, 90, 31, 0.55)';
      ctx.shadowBlur = size * 0.09;
      blobPath(t, ry * 0.8);
      // Centro rojo que se desplaza un poco; bordes naranja y amarillo.
      const ox = Math.sin(t * 0.6) * R * 0.18;
      const oy = Math.cos(t * 0.5) * R * 0.14;
      const g = ctx.createRadialGradient(c + ox, c + oy, 0, c, c, R * 1.18);
      g.addColorStop(0, '#c81e10');
      g.addColorStop(0.35, '#f0461a');
      g.addColorStop(0.58, '#ff7a1a');
      g.addColorStop(0.78, '#ffb52a');
      g.addColorStop(1, '#ffe05a');
      ctx.fillStyle = g;
      ctx.fill();
      ctx.restore();
      // Vetas de lava más oscura que se mueven por dentro.
      ctx.save();
      blobPath(t, ry * 0.8);
      ctx.clip();
      for (let i = 0; i < 2; i++) {
        const sx = c + Math.sin(t * (0.4 + i * 0.3) + i * 2) * R * 0.55;
        const sy = c + Math.cos(t * (0.35 + i * 0.25) + i) * R * 0.5;
        const sg = ctx.createRadialGradient(sx, sy, 0, sx, sy, R * 0.55);
        sg.addColorStop(0, 'rgba(150, 18, 8, 0.45)');
        sg.addColorStop(1, 'rgba(150, 18, 8, 0)');
        ctx.fillStyle = sg;
        ctx.fillRect(0, 0, size, size);
      }
      ctx.restore();
    };

    // Interacción: giro solo, inclinación hacia el cursor y arrastre con impulso.
    const zone = host.closest<HTMLElement>('[data-cube-zone]') ?? host;
    let rx = REST_X, ry = 0.6, tx = REST_X, ty = 0.6, spin = 0;
    let mode: 'auto' | 'hover' | 'drag' = 'auto';
    let hoverBase = 0;
    let last = { x: 0, y: 0 };

    zone.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse' || mode === 'drag') return;
      mode = 'hover';
      hoverBase = ty;
    });
    zone.addEventListener('pointerleave', () => {
      if (mode === 'hover') mode = 'auto';
    });
    zone.addEventListener('pointermove', (e) => {
      if (mode !== 'hover') return;
      const r = zone.getBoundingClientRect();
      const nx = ((e.clientX - r.left) / r.width - 0.5) * 2;
      const ny = ((e.clientY - r.top) / r.height - 0.5) * 2;
      ty = hoverBase + nx * 1.1;
      tx = REST_X + ny * 0.7;
    });
    host.addEventListener('pointerdown', (e) => {
      mode = 'drag';
      spin = 0;
      last = { x: e.clientX, y: e.clientY };
      host.setPointerCapture(e.pointerId);
      host.classList.add('dragging');
    });
    host.addEventListener('pointermove', (e) => {
      if (mode !== 'drag') return;
      const dx = e.clientX - last.x;
      const dy = e.clientY - last.y;
      last = { x: e.clientX, y: e.clientY };
      ty += dx * 0.01;
      tx = clamp(tx + dy * 0.008, -1.4, 1.4);
      spin = clamp(dx * 0.01, -0.3, 0.3);
    });
    const release = (e: PointerEvent) => {
      if (mode !== 'drag') return;
      host.classList.remove('dragging');
      const r = zone.getBoundingClientRect();
      const inside = e.pointerType === 'mouse' && e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
      mode = inside ? 'hover' : 'auto';
      hoverBase = ty;
    };
    host.addEventListener('pointerup', release);
    host.addEventListener('pointercancel', release);

    let time = 0;
    let lastTime = performance.now();
    let visible = true;
    let frame = 0;
    const tick = () => {
      const now = performance.now();
      const dt = Math.min((now - lastTime) / 1000, 0.05);
      lastTime = now;
      if (!reduceMotion.matches) time += dt;
      if (mode === 'auto') {
        ty += spin;
        spin *= 0.95;
        if (Math.abs(spin) < 0.002 && !reduceMotion.matches) ty += dt * 0.25;
        tx += (REST_X - tx) * 0.02;
      }
      const ease = mode === 'drag' ? 0.35 : 0.08;
      rx += (tx - rx) * ease;
      ry += (ty - ry) * ease;

      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, size, size);
      const pts = V.map((p) => project(p, rx, ry, 0.1));
      const edges = EDGES.map(([a, b]) => ({ a: pts[a], b: pts[b], z: (pts[a].z + pts[b].z) / 2 }));
      // Aristas de atrás, luego la masa, luego las de adelante.
      edges.filter((e) => e.z < 0).forEach((e) => drawEdge(e.a, e.b));
      pts.filter((p) => p.z < 0).forEach(drawCorner);
      drawBlob(time, ry);
      edges.filter((e) => e.z >= 0).forEach((e) => drawEdge(e.a, e.b));
      pts.filter((p) => p.z >= 0).forEach(drawCorner);

      frame = visible ? requestAnimationFrame(tick) : 0;
    };

    // Fuera de pantalla no se dibuja: no gasta batería.
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible && !frame) {
        lastTime = performance.now();
        frame = requestAnimationFrame(tick);
      }
    }).observe(host);
  });
</script>

<style>
  .forge {
    position: relative;
    width: min(100%, 520px);
    aspect-ratio: 1;
    cursor: grab;
    touch-action: none;
    user-select: none;
  }
  .forge.dragging {
    cursor: grabbing;
  }
  .forge canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
</style>
