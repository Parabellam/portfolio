---
// Cubo 3D en CSS (sin WebGL): la lava fluye por sus caras y el giro responde al mouse.
// Solo, gira despacio; al pasar el cursor sigue su posición; con clic o dedo se arrastra
// y conserva el impulso al soltarlo. El área que escucha el cursor es el contenedor
// más cercano con [data-cube-zone] (o el propio cubo).
interface Props {
  size?: string;
}

const { size = 'clamp(160px, 22vw, 320px)' } = Astro.props;
---

<div class="cube-wrap" style={`--s:${size}`} aria-hidden="true" data-cube>
  <div class="glow"></div>
  <div class="scene">
    <div class="cube">
      <div class="face f1"></div>
      <div class="face f2"></div>
      <div class="face f3"></div>
      <div class="face f4"></div>
      <div class="face f5"></div>
      <div class="face f6"></div>
    </div>
  </div>
  <div class="floor"></div>
</div>

<style>
  .cube-wrap {
    position: relative;
    cursor: grab;
    touch-action: none;
    user-select: none;
    width: var(--s);
    height: calc(var(--s) * 1.35);
    display: grid;
    place-items: center;
  }
  .glow {
    position: absolute;
    inset: -45%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 90, 31, 0.3) 0%, rgba(198, 42, 15, 0.1) 40%, transparent 70%);
    filter: blur(20px);
    animation: breathe 7s ease-in-out infinite alternate;
  }
  .scene {
    perspective: calc(var(--s) * 3.4);
  }
  .cube {
    width: var(--s);
    height: var(--s);
    position: relative;
    transform-style: preserve-3d;
    transform: rotateX(-24deg) rotateY(35deg) rotateZ(6deg);
    will-change: transform;
  }
  .cube-wrap.dragging {
    cursor: grabbing;
  }
  .face {
    position: absolute;
    inset: 0;
    border-radius: calc(var(--s) * 0.07);
    overflow: hidden;
    background:
      radial-gradient(circle at 62% 22%, rgba(20, 6, 2, 0.75) 0 7%, transparent 12%),
      radial-gradient(circle at 28% 70%, rgba(20, 6, 2, 0.6) 0 5%, transparent 10%),
      radial-gradient(circle at 30% 30%, #fff1b8 0%, #ffb020 10%, transparent 32%),
      radial-gradient(circle at 72% 62%, #ff5a1f 0%, transparent 42%),
      radial-gradient(circle at 40% 85%, #c62a0f 0%, transparent 48%),
      #2a0b04;
    background-size: 260% 260%, 300% 300%, 220% 220%, 240% 240%, 200% 200%, 100% 100%;
    animation: flow 7s ease-in-out infinite alternate;
    box-shadow:
      inset 0 0 calc(var(--s) * 0.22) rgba(10, 3, 1, 0.7),
      0 0 calc(var(--s) * 0.15) rgba(255, 90, 31, 0.35);
  }
  .f1 { transform: translateZ(calc(var(--s) / 2)); }
  .f2 { transform: rotateY(180deg) translateZ(calc(var(--s) / 2)); animation-delay: -2s; }
  .f3 { transform: rotateY(90deg) translateZ(calc(var(--s) / 2)); animation-delay: -4s; }
  .f4 { transform: rotateY(-90deg) translateZ(calc(var(--s) / 2)); animation-delay: -1s; }
  .f5 { transform: rotateX(90deg) translateZ(calc(var(--s) / 2)); animation-delay: -3s; }
  .f6 { transform: rotateX(-90deg) translateZ(calc(var(--s) / 2)); animation-delay: -5s; }
  .floor {
    position: absolute;
    bottom: 0;
    width: 110%;
    height: 12%;
    border-radius: 50%;
    background: radial-gradient(ellipse, rgba(255, 90, 31, 0.45), transparent 70%);
    filter: blur(12px);
  }
  @keyframes flow {
    0% { background-position: 0% 0%, 100% 20%, 10% 10%, 90% 60%, 40% 100%, 0 0; }
    100% { background-position: 80% 90%, 10% 80%, 90% 80%, 20% 10%, 70% 0%, 0 0; }
  }
  @keyframes breathe {
    from { opacity: 0.55; transform: scale(0.92); }
    to { opacity: 0.9; transform: scale(1.06); }
  }
  @media (prefers-reduced-motion: reduce) {
    .face, .glow { animation: none; }
  }
</style>

<script>
  const REST_X = -24;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const clamp = (v: number, min: number, max: number) => Math.min(max, Math.max(min, v));

  document.querySelectorAll<HTMLElement>('[data-cube]').forEach((wrap) => {
    const cube = wrap.querySelector<HTMLElement>('.cube')!;
    const zone = wrap.closest<HTMLElement>('[data-cube-zone]') ?? wrap;

    let rx = REST_X, ry = 35; // ángulo mostrado
    let tx = REST_X, ty = 35; // ángulo objetivo
    let spin = 0; // impulso tras soltar un arrastre (grados por cuadro)
    let mode: 'auto' | 'hover' | 'drag' = 'auto';
    let hoverBase = 0;
    let last = { x: 0, y: 0 };
    let visible = true;
    let frame = 0;

    zone.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse' || mode === 'drag') return;
      mode = 'hover';
      hoverBase = ty;
    });
    zone.addEventListener('pointerleave', () => {
      if (mode === 'hover') mode = 'auto';
    });
    zone.addEventListener('pointermove', (e) => {
      if (mode !== 'hover') return;
      const r = zone.getBoundingClientRect();
      const nx = ((e.clientX - r.left) / r.width - 0.5) * 2;
      const ny = ((e.clientY - r.top) / r.height - 0.5) * 2;
      ty = hoverBase + nx * 70;
      tx = REST_X - ny * 45;
    });

    wrap.addEventListener('pointerdown', (e) => {
      mode = 'drag';
      spin = 0;
      last = { x: e.clientX, y: e.clientY };
      wrap.setPointerCapture(e.pointerId);
      wrap.classList.add('dragging');
    });
    wrap.addEventListener('pointermove', (e) => {
      if (mode !== 'drag') return;
      const dx = e.clientX - last.x;
      const dy = e.clientY - last.y;
      last = { x: e.clientX, y: e.clientY };
      ty += dx * 0.6;
      tx = clamp(tx - dy * 0.5, -85, 85);
      spin = clamp(dx * 0.6, -18, 18); // un gesto brusco no lo deja girando sin control
    });
    const release = (e: PointerEvent) => {
      if (mode !== 'drag') return;
      wrap.classList.remove('dragging');
      const r = zone.getBoundingClientRect();
      const inside = e.pointerType === 'mouse' && e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
      mode = inside ? 'hover' : 'auto';
      hoverBase = ty;
    };
    wrap.addEventListener('pointerup', release);
    wrap.addEventListener('pointercancel', release);

    const tick = () => {
      if (mode === 'auto') {
        // Impulso que se va frenando, luego el giro lento de siempre.
        ty += spin;
        spin *= 0.95;
        if (Math.abs(spin) < 0.05 && !reduceMotion.matches) ty += 0.12;
        tx += (REST_X - tx) * 0.02;
      }
      const ease = mode === 'drag' ? 0.35 : 0.1;
      rx += (tx - rx) * ease;
      ry += (ty - ry) * ease;
      cube.style.transform = `rotateX(${rx}deg) rotateY(${ry}deg) rotateZ(6deg)`;
      frame = visible ? requestAnimationFrame(tick) : 0;
    };

    // Fuera de pantalla no se anima: no gasta batería.
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible && !frame) frame = requestAnimationFrame(tick);
    }).observe(wrap);
  });
</script>
