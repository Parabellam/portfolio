---
import site from '../data/site.json';

// Iconos de trazo (estilo Lucide, licencia ISC), dibujados con currentColor.
const ICONS = {
  email: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
  phone: '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>',
  linkedin: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>',
  github: '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>',
  cv: '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 13H8M16 17H8M16 13h-2"/>',
};

const { email, phone, linkedin, github, cv } = site.links;
const lastSegment = (url: string) => url.replace(/\/+$/, '').split('/').pop() ?? url;

const contacts = [
  email && { key: 'email', label: 'Email', value: email, href: `mailto:${email}`, external: false },
  phone && { key: 'phone', label: 'Teléfono', value: phone, href: `tel:${phone.replace(/\s+/g, '')}`, external: false },
  linkedin && { key: 'linkedin', label: 'LinkedIn', value: site.name, href: linkedin, external: true },
  github && { key: 'github', label: 'GitHub', value: lastSegment(github), href: github, external: true },
  cv && { key: 'cv', label: 'Hoja de vida', value: 'Descargar PDF', href: cv, external: true },
].filter(Boolean) as { key: keyof typeof ICONS; label: string; value: string; href: string; external: boolean }[];
---

<footer class="contact" id="contacto">
  <div class="wrap contact-inner">
    <div class="contact-intro">
      <h2>¿Hablamos?</h2>
      <p>{site.available ? 'Estoy abierto a nuevas oportunidades.' : 'Siempre abierto a conversar.'}</p>
    </div>
    <ul class="contact-list">
      {
        contacts.map((c) => (
          <li>
            <a class="contact-card" href={c.href} {...(c.external ? { target: '_blank', rel: 'noopener' } : {})}>
              <span class="contact-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[c.key]} />
              </span>
              <span class="contact-text">
                <span class="contact-label">{c.label}</span>
                <span class="contact-value">{c.value}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  .contact {
    margin-top: 6rem;
    padding-block: clamp(3.5rem, 8vw, 6rem);
    border-top: 1px solid var(--line);
    background: radial-gradient(ellipse 60% 80% at 15% 100%, rgba(255, 90, 31, 0.08), transparent 70%);
  }
  .contact-inner {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  .contact-intro h2 {
    margin: 0 0 0.75rem;
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .contact-intro p {
    margin: 0;
    font-size: 1.125rem;
    color: #b8ae9f;
  }
  .contact-list {
    display: grid;
    gap: 0.875rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .contact-card {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    min-height: 44px;
    padding: 1rem 1.125rem;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.15s, transform 0.15s;
  }
  .contact-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .contact-card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .contact-icon {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: #2a1509;
    color: #ff7a3d;
  }
  .contact-text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }
  .contact-label {
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .contact-value {
    font-size: 0.9375rem;
    font-weight: 500;
    overflow-wrap: anywhere;
  }
  @media (min-width: 560px) {
    .contact-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 900px) {
    .contact-inner {
      grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
      gap: 4rem;
    }
  }
</style>
