---
import {
  buildWeeks,
  formatLongDate,
  formatMonth,
  levelLabel,
  type DayMap,
  type Milestone,
} from '../lib/activity';

interface Props {
  days: DayMap;
  milestones?: Milestone[];
  weeks?: number;
  label: string;
}

const { days, milestones = [], weeks = 53, label } = Astro.props;
const columns = buildWeeks(days, weeks);

const byWeek = new Map<string, Milestone[]>();
for (const m of milestones) {
  byWeek.set(m.week, [...(byWeek.get(m.week) ?? []), m]);
}

// Etiqueta de mes en la primera semana de cada mes, solo si el mes ocupa
// al menos 3 columnas (evita que dos etiquetas se encimen en los bordes).
const monthOf = (i: number) => columns[i]?.cells[0].date.slice(0, 7);
const months = columns.map((col, i) => {
  const month = monthOf(i);
  if (i > 0 && month === monthOf(i - 1)) return '';
  return monthOf(i + 2) === month ? formatMonth(col.cells[0].date) : '';
});

function tipFor(date: string, level: number, monday: string) {
  const lines = [`${formatLongDate(date)} · ${levelLabel(level)}`];
  for (const m of byWeek.get(monday) ?? []) {
    lines.push(m.project ? `${m.project}: ${m.text}` : m.text);
  }
  return lines.join('\n');
}
---

<figure class="heatmap" aria-label={label} data-weeks={columns.length}>
  <div class="scroller" data-scroll-end>
    <div class="grid">
      <div class="months" aria-hidden="true">
        {months.map((m) => <span>{m}</span>)}
      </div>
      <div class="days" aria-hidden="true">
        <span>lun</span><span></span><span>mié</span><span></span><span>vie</span><span></span><span></span>
      </div>
      <div class="cells">
        {
          columns.map((col) => (
            <div class={`col${byWeek.has(col.monday) ? ' has-milestone' : ''}`}>
              {col.cells.map((cell) =>
                cell.future ? (
                  <span class="cell future" />
                ) : (
                  <span class={`cell l${cell.level}`} data-tip={tipFor(cell.date, cell.level, col.monday)} />
                ),
              )}
            </div>
          ))
        }
      </div>
    </div>
  </div>
  <figcaption class="legend">
    <span class="muted">Pasa el mouse por un día para ver en qué se trabajó esa semana.</span>
    <span class="scale" aria-hidden="true">
      Menos
      <span class="cell l0"></span><span class="cell l1"></span><span class="cell l2"></span><span class="cell l3"></span><span class="cell l4"></span>
      Más
    </span>
  </figcaption>
</figure>

<script>
  // En pantallas pequeñas se muestra primero lo más reciente.
  document.querySelectorAll<HTMLElement>('[data-scroll-end]').forEach((el) => {
    el.scrollLeft = el.scrollWidth;
  });
</script>

<style>
  /* Sin atributo style: la política de seguridad no permite estilos en línea. */
  .heatmap {
    --weeks: 53;
    margin: 0;
    container-type: inline-size;
  }
  .heatmap[data-weeks='26'] {
    --weeks: 26;
  }
  .scroller {
    --gap: 3px;
    /* Las celdas crecen hasta llenar el ancho disponible (28px = columna de días). */
    --cell: clamp(10px, calc((100cqi - 28px - var(--weeks) * var(--gap)) / var(--weeks)), 18px);
  }
  .scroller {
    overflow-x: auto;
    padding-bottom: 4px;
  }
  .grid {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    gap: 6px 8px;
    width: max-content;
  }
  .months {
    grid-column: 2;
    display: grid;
    grid-template-columns: repeat(var(--weeks), var(--cell));
    column-gap: var(--gap);
    font-size: 0.6875rem;
    color: var(--muted);
    white-space: nowrap;
    text-transform: capitalize;
    height: 1rem;
  }
  .days {
    grid-row: 2;
    display: grid;
    grid-template-rows: repeat(7, var(--cell));
    row-gap: var(--gap);
    font-size: 0.625rem;
    line-height: var(--cell);
    color: var(--muted);
  }
  .cells {
    grid-row: 2;
    grid-column: 2;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: var(--cell);
    column-gap: var(--gap);
  }
  .col {
    display: grid;
    grid-template-rows: repeat(7, var(--cell));
    row-gap: var(--gap);
  }
  .cell {
    width: var(--cell);
    height: var(--cell);
    border-radius: 2px;
    display: inline-block;
  }
  .cell.future {
    background: transparent;
  }
  .l0 { background: var(--heat-0); }
  .l1 { background: var(--heat-1); }
  .l2 { background: var(--heat-2); }
  .l3 { background: var(--heat-3); }
  .l4 { background: var(--heat-4); }
  .cells .cell:not(.future):hover {
    outline: 1.5px solid var(--ink);
    outline-offset: 1px;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-top: 0.75rem;
    font-size: 0.75rem;
  }
  .scale {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    color: var(--muted);
  }
  .scale .cell {
    width: 10px;
    height: 10px;
  }
</style>
