---
import type { CollectionEntry } from 'astro:content';
import Dual from './Dual.astro';
import { activeDays, projectDays } from '../lib/activity';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');

// "DevOps Hub: centro de control…" → título corto para el cartel + subtítulo.
const slides = projects.map((p, i) => {
  const [title, ...rest] = p.data.name.split(':');
  const subtitle = rest.join(':').trim();
  return {
    id: p.id,
    n: pad(i + 1),
    title: title.trim(),
    subtitle: subtitle ? subtitle[0].toUpperCase() + subtitle.slice(1) : '',
    long: title.trim().length > 18,
    data: p.data,
    days: activeDays(projectDays(p.id)),
  };
});
---

<section class="ps" id="proyectos" aria-label="Proyectos">
  <div class="ps-pin">
    <div class="ps-word-wrap">
      <h2 class="ps-word lava-text">Proyectos</h2>
    </div>
    <p class="ps-count" aria-hidden="true"><span data-count>1</span> / {pad(slides.length).replace(/^0/, '')}</p>
    <ol class="ps-rail" aria-hidden="true">
      {slides.map((s) => <li data-rail>{s.n}<span></span></li>)}
    </ol>

    {
      slides.map((s) => (
        <article class="ps-slide">
          <a class="ps-card" href={`/proyectos/${s.id}`}>
            <div class="ps-card-top">
              <span class="ps-n">{s.n}</span>
              <span class="badge">{s.data.category}</span>
              <span class={`status ${s.data.status === 'En producción' ? 'live' : ''}`}>{s.data.status}</span>
            </div>
            <span class="ps-big lava-text" aria-hidden="true">{s.n}</span>
            <h3 class:list={['ps-title', { long: s.long }]}>{s.title}</h3>
          </a>
          <div class="ps-text">
            {s.subtitle && <p class="ps-subtitle">{s.subtitle}</p>}
            <Dual value={s.data.pitch} as="p" class="ps-pitch" />
            <ul class="ps-highlights">
              {s.data.highlights.slice(0, 3).map((h) => <Dual value={h} as="li" />)}
            </ul>
            <div class="ps-foot">
              <a class="btn primary" href={`/proyectos/${s.id}`}>
                Ver proyecto
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </a>
              {s.days > 0 && <span class="muted"><strong>{s.days}</strong> días activos</span>}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);
  // En celular la barra del navegador aparece y desaparece al hacer scroll; sin esto la
  // animación recalcula y salta.
  ScrollTrigger.config({ ignoreMobileResize: true });

  const section = document.querySelector<HTMLElement>('.ps')!;
  section.classList.add('lava-paused');
  new IntersectionObserver(([entry]) => section.classList.toggle('lava-paused', !entry.isIntersecting)).observe(section);
  const mm = gsap.matchMedia();
  const motion = '(prefers-reduced-motion: no-preference)';

  // Escritorio: tarjeta a la izquierda y texto a la derecha. Celular: tarjeta arriba y texto abajo.
  // Con movimiento reducido no se fija nada y la sección queda como una lista normal (CSS base).
  mm.add({ desktop: `(min-width: 900px) and ${motion}`, mobile: `(max-width: 899px) and ${motion}` }, (context) => {
    const desktop = !!context.conditions?.desktop;
    section.classList.add('is-pinned');
    section.classList.toggle('is-mobile', !desktop);
    const slides = gsap.utils.toArray<HTMLElement>('.ps-slide', section);
    const rail = gsap.utils.toArray<HTMLElement>('[data-rail]', section);
    const count = section.querySelector<HTMLElement>('[data-count]')!;
    const word = section.querySelector<HTMLElement>('.ps-word')!;

    // En escritorio la tarjeta empieza centrada en pantalla y luego se corre a la izquierda.
    const centerShift = (card: HTMLElement) =>
      desktop ? window.innerWidth / 2 - (card.offsetLeft + card.offsetWidth / 2) : 0;

    gsap.set(slides, { autoAlpha: 0 });
    if (desktop) gsap.set(section.querySelectorAll('.ps-text'), { yPercent: -50 });

    const tl = gsap.timeline({
      defaults: { ease: 'none' },
      scrollTrigger: {
        trigger: section,
        start: 'top top',
        end: () => `+=${window.innerHeight * (slides.length * 2.2 + 1)}`,
        pin: '.ps-pin',
        scrub: 0.6,
        invalidateOnRefresh: true,
      },
    });

    // 1. La palabra llena la pantalla y se aleja hacia arriba.
    tl.to(word, {
      scale: desktop ? 0.28 : 0.45,
      y: () => -(window.innerHeight / 2 - 100),
      opacity: 0.18,
      duration: 1.2,
      ease: 'power1.inOut',
    });

    const starts: number[] = [];
    slides.forEach((slide, i) => {
      const card = slide.querySelector<HTMLElement>('.ps-card')!;
      const text = slide.querySelector<HTMLElement>('.ps-text')!;
      const at = i === 0 ? '-=0.5' : '-=0.35';

      // 2. La tarjeta sube desde abajo, un poco más grande.
      tl.set(slide, { autoAlpha: 1 }, at);
      starts.push(tl.duration());
      tl.fromTo(
        card,
        { y: () => window.innerHeight, x: () => centerShift(card), scale: desktop ? 1.3 : 1.06 },
        { y: 0, duration: 1, ease: 'power2.out' },
        '<',
      );
      // 3. Se asienta y entra el texto (por la derecha en escritorio, por abajo en celular).
      tl.to(card, { x: 0, scale: 1, duration: desktop ? 0.9 : 0.5, ease: 'power2.inOut' });
      tl.fromTo(
        text,
        desktop ? { x: 80, autoAlpha: 0 } : { y: 30, autoAlpha: 0 },
        { x: 0, y: 0, autoAlpha: 1, duration: 0.6, ease: 'power2.out' },
        '-=0.45',
      );
      tl.to({}, { duration: 0.5 }); // pausa para leer

      // 4. Sale hacia arriba y deja paso al siguiente.
      if (i < slides.length - 1) {
        tl.to([card, text], { y: () => -window.innerHeight * 0.9, autoAlpha: 0, duration: 0.9, ease: 'power2.in' });
      }
    });

    const update = () => {
      const t = tl.time();
      let active = 0;
      starts.forEach((s, i) => { if (t >= s) active = i; });
      count.textContent = String(active + 1);
      rail.forEach((r, i) => r.classList.toggle('on', i === active));
    };
    tl.eventCallback('onUpdate', update);
    update();

    // En escritorio el texto va en una columna de alto fijo y la vista técnica es mucho más larga.
    // Si no cabe, se reduce la letra hasta un 20 %; si aun así no cabe, cada destacado se corta a
    // 3 líneas (el texto completo sigue en la página del proyecto).
    const texts = gsap.utils.toArray<HTMLElement>('.ps-text', section);
    const fitTexts = () => {
      if (!desktop) return;
      const maxH = window.innerHeight * 0.8 - 20; // deja libre la barra superior
      texts.forEach((el) => {
        el.classList.remove('clamped');
        let fit = 1;
        el.style.setProperty('--fit', '1');
        while (el.offsetHeight > maxH && fit > 0.8) {
          fit = Math.round((fit - 0.05) * 100) / 100;
          el.style.setProperty('--fit', String(fit));
        }
        if (el.offsetHeight > maxH) el.classList.add('clamped');
      });
    };
    fitTexts();
    ScrollTrigger.addEventListener('refreshInit', fitTexts);
    // Cambiar entre General y Técnica cambia el largo del texto.
    const viewObserver = new MutationObserver(fitTexts);
    viewObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-view'] });

    return () => {
      ScrollTrigger.removeEventListener('refreshInit', fitTexts);
      viewObserver.disconnect();
      texts.forEach((el) => {
        el.classList.remove('clamped');
        el.style.removeProperty('--fit');
      });
      section.classList.remove('is-pinned', 'is-mobile');
    };
  });
</script>

<style>
  /* Base (celular, sin JS o con movimiento reducido): lista normal. */
  .ps {
    margin-top: 5rem;
  }
  .ps-pin {
    width: 100%;
    max-width: 1080px;
    margin-inline: auto;
    padding-inline: 1rem;
    box-sizing: border-box;
  }
  .ps-word-wrap {
    margin-bottom: 1.5rem;
  }
  .ps-word {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(64px, 16vw, 140px);
    line-height: 0.9;
    text-transform: uppercase;
  }
  .ps-count,
  .ps-rail {
    display: none;
  }
  .ps-slide {
    display: grid;
    gap: 1.25rem;
    margin-bottom: 3.5rem;
  }
  .ps-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    min-height: 260px;
    padding: 1.5rem;
    box-sizing: border-box;
    border-radius: 24px;
    background: var(--surface);
    border: 1px solid #3a2a1e;
    box-shadow: 0 30px 120px rgba(255, 90, 31, 0.14);
    color: var(--ink);
    text-decoration: none;
    overflow: hidden;
  }
  .ps-card:hover {
    border-color: var(--accent);
  }
  .ps-card-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    position: relative;
    z-index: 1;
  }
  .ps-n {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--accent-2);
  }
  .ps-big {
    position: absolute;
    right: -0.04em;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(160px, 26vw, 360px);
    line-height: 0.8;
    opacity: 0.55;
  }
  .ps-title {
    position: relative;
    z-index: 1;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(48px, 7vw, 104px);
    line-height: 0.86;
    text-transform: uppercase;
    max-width: 11ch;
  }
  .ps-title.long {
    font-size: clamp(36px, 4.6vw, 64px);
    max-width: 14ch;
  }
  .ps-text {
    display: grid;
    gap: 1.25rem;
  }
  .ps-subtitle {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .ps-pitch {
    margin: 0;
    color: var(--muted);
    font-size: 1.0625rem;
  }
  .ps-highlights {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ps-highlights :global(li) {
    position: relative;
    padding-left: 1.4rem;
    font-size: 0.9375rem;
  }
  .ps-highlights :global(li)::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--accent);
  }
  .ps-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
  }
  .ps-foot strong {
    color: var(--accent-2);
  }

  /* Escritorio con movimiento: pantalla fija y secuencia con el scroll. */
  .ps.is-pinned {
    margin-top: 0;
  }
  .is-pinned .ps-pin {
    position: relative;
    max-width: none;
    height: 100vh;
    padding: 0;
    overflow: hidden;
  }
  .is-pinned .ps-word-wrap {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    margin: 0;
  }
  .is-pinned .ps-word {
    font-size: min(21vw, 38vh);
    will-change: transform;
  }
  .is-pinned .ps-count {
    display: block;
    position: absolute;
    top: 84px;
    right: 6vw;
    margin: 0;
    color: var(--muted);
    font-size: 0.875rem;
  }
  .is-pinned .ps-rail {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 18px;
    position: absolute;
    right: 40px;
    top: 50%;
    transform: translateY(-50%);
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 12px;
    color: #6e665b;
    z-index: 2;
  }
  .ps-rail li {
    display: flex;
    align-items: center;
    gap: 10px;
    transition: color 0.3s;
  }
  .ps-rail li span {
    width: 18px;
    height: 2px;
    background: #3a322a;
    transition: width 0.3s, background 0.3s;
  }
  .ps-rail li.on {
    color: var(--accent-2);
  }
  .ps-rail li.on span {
    width: 36px;
    background: var(--accent);
  }
  .is-pinned .ps-slide {
    position: absolute;
    inset: 0;
    display: block;
    margin: 0;
  }
  .is-pinned .ps-card {
    position: absolute;
    left: 6vw;
    top: 50%;
    width: 44vw;
    height: 64vh;
    margin-top: -32vh;
    padding: 2rem;
    will-change: transform;
  }
  .is-pinned:not(.is-mobile) .ps-subtitle {
    font-size: calc(1.5rem * var(--fit, 1));
  }
  .is-pinned:not(.is-mobile) .ps-pitch {
    font-size: calc(1.0625rem * var(--fit, 1));
  }
  .is-pinned:not(.is-mobile) .ps-highlights :global(li) {
    font-size: calc(0.9375rem * var(--fit, 1));
  }
  .is-pinned .ps-text.clamped .ps-pitch {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    overflow: hidden;
  }
  .is-pinned .ps-text.clamped .ps-highlights :global(li) {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }
  .is-pinned .ps-text {
    position: absolute;
    left: 54vw;
    top: 50%;
    width: 35vw;
    display: grid;
    gap: 1.25rem;
  }
  /* Celular con movimiento: tarjeta arriba a todo el ancho y texto debajo. */
  .is-pinned.is-mobile .ps-pin {
    height: 100vh;
    height: 100svh;
  }
  .is-pinned.is-mobile .ps-rail {
    display: none;
  }
  .is-pinned.is-mobile .ps-count {
    top: 72px;
    right: 16px;
  }
  .is-pinned.is-mobile .ps-card {
    left: 16px;
    width: calc(100% - 32px);
    top: 132px;
    height: min(38svh, 320px);
    margin-top: 0;
    padding: 1.25rem;
    border-radius: 20px;
  }
  .is-pinned.is-mobile .ps-big {
    font-size: min(44vw, 170px);
  }
  .is-pinned.is-mobile .ps-title {
    font-size: clamp(40px, 13vw, 56px);
  }
  .is-pinned.is-mobile .ps-title.long {
    font-size: clamp(28px, 8.5vw, 36px);
  }
  .is-pinned.is-mobile .ps-text {
    left: 16px;
    width: calc(100% - 32px);
    top: calc(132px + min(38svh, 320px) + 16px);
    gap: 0.85rem;
  }
  .is-pinned.is-mobile .ps-subtitle {
    font-size: 1.2rem;
  }
  .is-pinned.is-mobile .ps-pitch {
    font-size: 0.9375rem;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 5;
    line-clamp: 5;
    overflow: hidden;
  }
  .is-pinned.is-mobile .ps-highlights {
    display: none;
  }
  @media (max-height: 700px) {
    .is-pinned.is-mobile .ps-pitch {
      -webkit-line-clamp: 3;
      line-clamp: 3;
    }
  }

  @media (min-width: 900px) {
    .ps-slide {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 2.5rem;
    }
  }
</style>
