---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Heatmap from '../components/Heatmap.astro';
import ProjectCard from '../components/ProjectCard.astro';
import site from '../data/site.json';
import { activeDays, mergeDays, projectDays, type Milestone } from '../lib/activity';

const projects = (await getCollection('projects')).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.order - b.data.order,
);

const allDays = mergeDays(projects.map((p) => projectDays(p.id)));
const totalActive = activeDays(allDays);
const inProduction = projects.filter((p) => p.data.status === 'En producción').length;
const milestones: Milestone[] = projects.flatMap((p) =>
  p.data.milestones.map((m) => ({ ...m, project: p.data.name })),
);
const categories = [...new Set(projects.map((p) => p.data.category))];
---

<Base>
  <section class="hero wrap">
    {
      site.available && (
        <p class="available">
          <span class="dot" /> Abierto a nuevas oportunidades
        </p>
      )
    }
    <p class="eyebrow">{site.role} · {site.location}</p>
    <h1>{site.headline}</h1>
    <p class="lead">{site.bio}</p>
    <div class="actions">
      <a class="btn primary" href="#proyectos">Ver proyectos</a>
      <a class="btn" href="#contacto">Contactar</a>
    </div>
  </section>

  <section class="wrap stats" aria-label="Resumen">
    <div class="stat">
      <span class="stat-value">{totalActive}</span>
      <span class="stat-label">días construyendo en el último año</span>
    </div>
    <div class="stat">
      <span class="stat-value">{projects.length}</span>
      <span class="stat-label">proyectos publicados aquí</span>
    </div>
    <div class="stat">
      <span class="stat-value">{inProduction}</span>
      <span class="stat-label">en producción hoy</span>
    </div>
  </section>

  <section class="wrap section" id="actividad">
    <div class="section-head">
      <h2>Actividad del último año</h2>
      <p class="muted">
        Cada cuadro es un día. Cuanto más intenso el color, más avance hubo en mis proyectos. Se actualiza solo cada semana.
      </p>
    </div>
    <div class="panel">
      <Heatmap days={allDays} milestones={milestones} label={`${totalActive} días activos en el último año`} />
    </div>
  </section>

  <section class="wrap section" id="proyectos">
    <div class="section-head">
      <h2>Proyectos</h2>
      <p class="muted">
        Usa <strong>General</strong> para una explicación sin tecnicismos o <strong>Técnica</strong> para ver
        arquitectura y stack.
      </p>
    </div>
    {
      categories.length > 1 && (
        <div class="filters" role="group" aria-label="Filtrar por categoría">
          <button type="button" data-filter="" aria-pressed="true">
            Todos
          </button>
          {categories.map((c) => (
            <button type="button" data-filter={c} aria-pressed="false">
              {c}
            </button>
          ))}
        </div>
      )
    }
    <div class="cards">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('.card[data-category]');
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const f = b.dataset.filter;
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      cards.forEach((c) => (c.hidden = !!f && c.dataset.category !== f));
    }),
  );
</script>

<style>
  .hero {
    padding-block: clamp(3rem, 8vw, 6rem) 2.5rem;
  }
  .available {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1.25rem;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.8125rem;
    background: var(--surface);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--ok) 25%, transparent);
  }
  .eyebrow {
    margin: 0 0 0.75rem;
    color: var(--accent);
    font-weight: 600;
    font-size: 0.9375rem;
  }
  h1 {
    max-width: 22ch;
    margin: 0 0 1.25rem;
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
  }
  .lead {
    max-width: 60ch;
    margin: 0 0 2rem;
    font-size: 1.125rem;
    color: var(--muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .stat-value {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .stat-label {
    color: var(--muted);
    font-size: 0.875rem;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }
  .filters button {
    font: inherit;
    font-size: 0.8125rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
  }
  .filters button[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 1rem;
  }
  @media (max-width: 640px) {
    .stats {
      grid-template-columns: 1fr;
    }
    .stat {
      flex-direction: row;
      align-items: baseline;
      gap: 0.75rem;
    }
    .stat-value {
      font-size: 1.5rem;
    }
  }
</style>
