---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Heatmap from '../components/Heatmap.astro';
import ForgeCube from '../components/ForgeCube.astro';
import ProjectsScroll from '../components/ProjectsScroll.astro';
import site from '../data/site.json';
import { activeDays, mergeDays, projectDays, type Milestone } from '../lib/activity';

const projects = (await getCollection('projects')).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.order - b.data.order,
);

const allDays = mergeDays(projects.map((p) => projectDays(p.id)));
const totalActive = activeDays(allDays);
const inProduction = projects.filter((p) => p.data.status === 'En producción').length;
const milestones: Milestone[] = projects.flatMap((p) =>
  p.data.milestones.map((m) => ({ ...m, project: p.data.name })),
);
const pad = (n: number) => String(n).padStart(2, '0');
---

<Base>
  <section class="hero wrap">
    <div class="hero-text">
      <div class="hero-meta">
        {
          site.available && (
            <p class="available">
              <span class="dot" /> Abierto a nuevas oportunidades
            </p>
          )
        }
        <p class="eyebrow">{site.role} · {site.location}</p>
      </div>
      <h1>{site.headline}</h1>
      <p class="lead">{site.bio}</p>
      <div class="actions">
        <a class="btn primary" href="#proyectos">
          Ver proyectos
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a class="btn" href="#contacto">Contactar</a>
      </div>
    </div>
    <div class="hero-cube" data-cube-zone>
      <ForgeCube />
    </div>
    <dl class="stats">
      <div class="stat">
        <dt>días activos en proyectos personales</dt>
        <dd class="stat-value hot">{totalActive}</dd>
      </div>
      <div class="stat">
        <dt>proyectos publicados aquí</dt>
        <dd class="stat-value">{pad(projects.length)}</dd>
      </div>
      <div class="stat">
        <dt>en producción hoy</dt>
        <dd class="stat-value">{pad(inProduction)}</dd>
      </div>
    </dl>
  </section>

  <ProjectsScroll projects={projects} />

  <section class="wrap section" id="actividad">
    <div class="section-head">
      <h2>Actividad en mis proyectos personales</h2>
      <p class="muted">
        Cada cuadro es un día del último año: cuanto más intenso el color, más avance hubo. Se actualiza solo cada semana.
      </p>
    </div>
    <div class="panel">
      <Heatmap days={allDays} milestones={milestones} label={`${totalActive} días activos en proyectos personales en el último año`} />
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    grid-template-areas:
      'text cube'
      'stats stats';
    align-items: center;
    gap: 2rem 3rem;
    min-height: calc(100vh - 61px);
    padding-block: 3rem 2.5rem;
    box-sizing: border-box;
  }
  .hero-text {
    grid-area: text;
  }
  .hero-cube {
    grid-area: cube;
    display: grid;
    place-items: center;
  }
  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-bottom: 1.5rem;
  }
  .available {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0.3rem 0.8rem;
    border: 1px solid #3a2a1e;
    border-radius: 999px;
    font-size: 0.8125rem;
    background: #16110d;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-2);
    box-shadow: 0 0 10px var(--accent);
  }
  .eyebrow {
    margin: 0;
    color: var(--muted);
    font-size: 0.875rem;
  }
  h1 {
    max-width: 20ch;
    margin: 0 0 1.25rem;
    font-size: clamp(2.125rem, 4.4vw, 3.75rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.03em;
  }
  .lead {
    max-width: 58ch;
    margin: 0 0 2rem;
    font-size: 1.125rem;
    color: #b8ae9f;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .stats {
    grid-area: stats;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 3.5rem;
    margin: 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.15rem;
  }
  .stat dt {
    color: var(--muted);
    font-size: 0.875rem;
  }
  .stat-value {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 3rem;
    line-height: 1;
  }
  .stat-value.hot {
    color: var(--accent-2);
  }
  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr;
      grid-template-areas: 'text' 'cube' 'stats';
      min-height: 0;
      padding-top: 2rem;
      gap: 1.5rem;
    }
    .hero-cube :global(.forge) {
      width: min(64vw, 250px);
    }
    .stat-value {
      font-size: 2.25rem;
    }
  }
</style>
