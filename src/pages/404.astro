---
import Base from '../layouts/Base.astro';
---

<Base title="Página no encontrada">
  <section class="wrap missing">
    <h1>Esta página no existe</h1>
    <p class="muted">Puede que el proyecto haya cambiado de nombre.</p>
    <a class="btn primary" href="/">Volver al inicio</a>
  </section>
</Base>

<style>
  .missing {
    padding-block: 6rem 2rem;
  }
  h1 {
    margin: 0 0 1rem;
    letter-spacing: -0.03em;
  }
  p {
    margin: 0 0 2rem;
  }
</style>
