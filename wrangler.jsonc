{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Solo archivos estáticos: Cloudflare sirve dist/ sin ejecutar código (no hay Worker propio).
  "name": "portafolio",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "stiven.gg-forge.com", "custom_domain": true }],
  "workers_dev": false
}
